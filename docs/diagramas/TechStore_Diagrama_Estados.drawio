        </mxCell>
        <mxCell id="footer_text" parent="1" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#586C84;" value="&lt;ol&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(88, 108, 132), rgb(131, 148, 168));&quot;&gt;&lt;font style=&quot;font-size: 14.5px;&quot;&gt;Antes de realizar una transición, se comprueba que se cumplan las condiciones correspondientes.&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(88, 108, 132), rgb(131, 148, 168));&quot;&gt;&lt;font style=&quot;font-size: 14.5px;&quot;&gt;Si la operación es válida, cambia el estado del pedido y se registra su Domain Event.&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(88, 108, 132), rgb(131, 148, 168));&quot;&gt;&lt;font style=&quot;font-size: 14.5px;&quot;&gt;Si la operación falla, el pedido conserva su estado y no se genera un nuevo evento.&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14.5px;&quot;&gt;&lt;code style=&quot;background-color: transparent; color: light-dark(rgb(88, 108, 132), rgb(131, 148, 168));&quot;&gt;CANCELLED&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(88, 108, 132), rgb(131, 148, 168));&quot;&gt;, &lt;/span&gt;&lt;code style=&quot;background-color: transparent; color: light-dark(rgb(88, 108, 132), rgb(131, 148, 168));&quot;&gt;DELIVERED&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(88, 108, 132), rgb(131, 148, 168));&quot;&gt; y &lt;/span&gt;&lt;code style=&quot;background-color: transparent; color: light-dark(rgb(88, 108, 132), rgb(131, 148, 168));&quot;&gt;RETURNED&lt;/code&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(88, 108, 132), rgb(131, 148, 168));&quot;&gt; son estados finales.&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;/ol&gt;" vertex="1">
          <mxGeometry height="51" width="1320" x="83" y="740" as="geometry" />
        </mxCell>
